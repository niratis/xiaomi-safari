# Xiaomi Points Collector Configuration
# Copy this file to .env and fill in your details

# Your Xiaomi account email/phone (optional - only needed for auto-login attempts)
# If left blank, you'll use the interactive browser login on first run
XIAOMI_EMAIL=
XIAOMI_PASSWORD=

# Region: uk, de, fr, es, it, nl (default: uk)
XIAOMI_REGION=uk

# Run headless (no visible browser window). Set to false for debugging.
# First-time login always runs in headed mode so you can log in manually.
HEADLESS=true

# How long to wait for pages to load (in milliseconds)
PAGE_TIMEOUT=30000

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Path to store session data and logs (defaults to project directory)
# DATA_DIR=./

# Enable desktop notifications on macOS (true/false)
NOTIFICATIONS=true
